generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "mysql"
  url      = env("DATABASE_URL")
}

enum Role {
  ADMIN
  ORGANIZER
  STAFF
  BUYER
}

model User {
  id           Int      @id @default(autoincrement())
  name         String
  email        String   @unique
  passwordHash String   @map("password_hash")
  role         Role     @default(BUYER)
  createdAt    DateTime @default(now()) @map("created_at")

  events       Event[]
  orders       Order[]

  @@map("users")
}

enum EventStatus {
  DRAFT
  PUBLISHED
  CANCELLED
}

model Event {
  id          Int         @id @default(autoincrement())
  organizerId Int         @map("organizer_id")
  title       String
  description String      @db.Text
  location    String
  capacity    Int
  startsAt    DateTime    @map("starts_at")
  endsAt      DateTime    @map("ends_at")
  status      EventStatus @default(DRAFT)
  createdAt   DateTime    @default(now()) @map("created_at")

  organizer   User        @relation(fields: [organizerId], references: [id])
  lots        TicketLot[]

  @@map("events")
}

model TicketLot {
  id           Int      @id @default(autoincrement())
  eventId      Int      @map("event_id")
  name         String
  price        Decimal  @db.Decimal(10, 2)
  quantity     Int
  salesStartAt DateTime @map("sales_start_at")
  salesEndAt   DateTime @map("sales_end_at")
  active       Boolean  @default(true)
  createdAt    DateTime @default(now()) @map("created_at")

  event        Event    @relation(fields: [eventId], references: [id], onDelete: Cascade)
  orderItems   OrderItem[]

  @@map("ticket_lots")
}

enum OrderStatus {
  PENDING
  PAID
  EXPIRED
  CANCELLED
}

model Order {
  id          Int         @id @default(autoincrement())
  userId      Int         @map("user_id")
  status      OrderStatus @default(PENDING)
  total       Decimal     @db.Decimal(20, 2)
  expiresAt   DateTime    @map("expires_at")
  createdAt   DateTime    @default(now()) @map("created_at")
  paidAt      DateTime?   @map("paid_at")
  cancelledAt DateTime?   @map("cancelled_at")

  user        User        @relation(fields: [userId], references: [id], onDelete: Restrict)
  items       OrderItem[]

  @@index([status, expiresAt])
  @@index([userId])
  @@map("orders")
}

model OrderItem {
  id                Int       @id @default(autoincrement())
  orderId           Int       @map("order_id")
  lotId             Int       @map("lot_id")
  quantity          Int
  unitPriceSnapshot Decimal   @map("unit_price_snapshot") @db.Decimal(10, 2)

  order             Order     @relation(fields: [orderId], references: [id], onDelete: Restrict)
  lot               TicketLot @relation(fields: [lotId], references: [id], onDelete: Restrict)

  @@unique([orderId, lotId])
  @@index([lotId])
  @@map("order_items")
}
